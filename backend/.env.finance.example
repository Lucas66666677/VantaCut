# Main Taiwan-market source: official TWSE daily data. It is end-of-day, not a real-time quote feed.
FINANCE_PROVIDER=twse
FINANCE_CACHE_TTL_SECONDS=900
FINANCE_TWSE_TIMEOUT_SECONDS=20

# Optional: a contractually licensed Yahoo-compatible provider. Never expose this key to Next.js.
FINANCE_YAHOO_COMPATIBLE_BASE_URL=https://licensed-market-data.example/api
FINANCE_YAHOO_COMPATIBLE_API_KEY=replace-with-secret-manager-value
# Enable only if the provider agreement permits server-side caching/redistribution.
FINANCE_YAHOO_CACHE_ALLOWED=false
