# Required in staging/production. Store this random 32+ byte value in a secret manager.
DISTRIBUTED_COMPUTE_TRACKER_KEY=replace-with-a-random-server-side-secret
DISTRIBUTED_COMPUTE_TICKET_TTL_SECONDS=900
DISTRIBUTED_COMPUTE_CREDIT_PER_VERIFIED_CHUNK=1
# Browser nodes are limited to small jobs. 4K/8K require a verified desktop runtime.
DISTRIBUTED_COMPUTE_MAX_BROWSER_RESOLUTION=1080
