# Lecturas uses the existing neutral AUDIO_DESCRIPTION_TTS_COMMAND and an authorised AvatarProfile.
# It never clones the lecturer voice automatically.
AI_VISION_PROVIDER=gemini
AVATAR_AUDIO_PROVIDER=audio2face
AUDIO2FACE_GATEWAY_URL=http://audio2face.internal:8011
AVATAR_UNREAL_COMMAND=/opt/Unreal/Engine/Binaries/Linux/UnrealEditor-Cmd
AVATAR_UNREAL_PROJECT=/srv/avatar/AvatarRender.uproject
# AUDIO_DESCRIPTION_TTS_COMMAND must contain {text}, {output}; {language} is optional.
AUDIO_DESCRIPTION_TTS_COMMAND="/srv/bin/neutral-tts --text {text} --output {output} --language {language}"
