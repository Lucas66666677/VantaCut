# Select a provider-approved gateway implementing POST /generate and GET /jobs/{id}.
# Never point these credentials at an undocumented consumer web endpoint.
MUSIC_GENERATION_PROVIDER=suno
MUSIC_GENERATION_API_KEY=replace-with-server-side-secret
MUSIC_GENERATION_BASE_URL=https://your-licensed-music-gateway.example/v1
MUSIC_GENERATION_TIMEOUT_SECONDS=1800
MUSIC_GENERATION_POLL_SECONDS=4
# Spleeter executable available only on the GPU/audio worker image.
MUSIC_STEM_SEPARATOR_COMMAND=spleeter
