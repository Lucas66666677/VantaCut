# Set true only for the production AWS S3 bucket; MinIO development stays false.
MAM_S3_LIFECYCLE_ENABLED=true
MAM_ARCHIVE_AFTER_DAYS=30
MAM_RESTORE_DAYS=3
MAM_RESTORE_TIER=Standard
MAM_RESTORE_ETA_HOURS=12
MAM_FREE_TTL_DAYS=90
MAM_NOTICE_DAYS=60,75,85
SENDGRID_API_KEY=SG.replace-me
SENDGRID_FROM_EMAIL=storage@example.com
WEB_APP_BASE_URL=https://app.example.com
# Optional licensed FACS Action Unit model for consented presentation coaching.
FACS_ONNX_PATH=/models/facs-action-units.onnx
FACS_INPUT_SIZE=224
