# A neutral narrator (not voice cloning) command. Install/configure Piper on the worker.
# The command must create the WAV named by {output}; {language} is optional.
AUDIO_DESCRIPTION_TTS_COMMAND=piper --model /models/zh_CN-huayan-medium.onnx --output_file {output} --text {text}
AUDIO_DESCRIPTION_WORDS_PER_SECOND=2.2
AUDIO_DESCRIPTION_TTS_TIMEOUT_SECONDS=300
