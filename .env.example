POSTGRES_DB=video_editor
POSTGRES_USER=video_editor
POSTGRES_PASSWORD=video_editor_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=media

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

ENVIRONMENT=development
MOCK_AI=true
MOCK_AI_DELAY_SECONDS=0.35

AI_VISION_PROVIDER=gemini
AI_ASR_PROVIDER=openai_whisper
AI_TEXT_PROVIDER=gemini
AI_DIRECTOR_PROVIDER=openai
AI_EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_VISION_MODEL=gemini-video-model
OPENAI_VISION_MODEL=gpt-4o
OPENAI_ASR_MODEL=whisper-1
GEMINI_TEXT_MODEL=gemini-video-model
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_DIRECTOR_MODEL=gpt-4o
# Production command template, e.g. `python /opt/tts.py --text-file {text_file} --output {output} --language {language}`.
# In development with MOCK_AI=true, Auto Director creates a deterministic silent WAV instead.
TTS_COMMAND=
# Generate an optional transparent VP9/WebM kinetic-caption artifact in addition to ASS.
KINETIC_SUBTITLE_WEBM=false

# Optional: absolute path inside the worker container to a vetted, licensed gaze-redirection ONNX model.
# Leave empty to keep the opt-in gaze-redirection endpoint unavailable.
GAZE_REDIRECTION_ONNX_PATH=

# GPU worker only.  The command must include {input}, {masks}, and {output} placeholders.
VIDEO_INPAINTING_PROVIDER=propainter
PROPAINTER_COMMAND=
CELERY_INPAINTING_QUEUE=celery

# Optional neural foley wrapper (AudioLDM/Stable Audio or equivalent). Without it, procedural audio is used.
# Must include {prompt}, {duration}, and {output}.
AUDIO_GENERATION_COMMAND=
# Licensed encoder handoff only; must include {video}, {adm_bwf}, and {output}.
DOLBY_ATMOS_ENCODER_COMMAND=
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k

# Social publishing: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
SOCIAL_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
SOCIAL_TOKEN_ENCRYPTION_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional vetted image-generation command. It must accept {prompt} and {output} placeholders.
THUMBNAIL_GENERATION_COMMAND=

# Screen recording focus: template images of the visible cursor, comma-separated. Without them the OCR path still works,
# but cursor tracking is explicitly unavailable rather than guessed.
SCREEN_FOCUS_OCR_LANG=eng
SCREEN_FOCUS_CURSOR_TEMPLATES=

# Optional Depth Anything V2 ONNX model. If empty, the relighting pipeline falls back to MiDaS Small.
DEPTH_ANYTHING_ONNX_PATH=

# GPU video matting: install backend/requirements.sam2.txt and mount a SAM 2 checkpoint into the GPU worker.
SAM2_CHECKPOINT_PATH=
SAM2_CONFIG_PATH=configs/sam2.1/sam2.1_hiera_l.yaml
MATTING_FRAME_STRIDE=1

# Optional renderer (rlottie/Skia/resvg wrapper) with {input}, {output}, {width}, {height}, {fps}, {duration} placeholders.
# It must write a transparent, timeline-duration-matched video to {output}.
LOTTIE_RENDER_COMMAND=

# Voice cloning: install backend/requirements.xtts.txt and run these tasks on an isolated GPU worker.
# Generate the Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_VOICE_PROVIDER=xtts_v2
VOICE_PROFILE_ENCRYPTION_KEY=
XTTS_MODEL_DIR=/models/xtts-v2
XTTS_CONFIG_PATH=
XTTS_DEVICE=cuda
XTTS_USE_DEEPSPEED=false

# Optional custom FFmpeg build with the non-standard gltransition filter enabled.
FFMPEG_GLTRANSITION_ENABLED=false

# Lip-sync GPU command templates must include {video}, {audio}, and {output}.
# The original Wav2Lip open-source weights are research/personal only; set this only with a valid commercial license.
WAV2LIP_COMMAND=
WAV2LIP_COMMERCIAL_LICENSED=false
SADTALKER_COMMAND=

# Emotion-preserving Speech-to-Speech voice morphing. The trusted GPU-worker
# command receives original audio and F0/RMS JSON; it must write a same-length WAV.
# Required placeholders: {input} {output} {model} {f0_json} {envelope_json} {pitch_shift}
RVC_CONVERT_COMMAND=
RVC_ROBOT_MODEL_PATH=
RVC_MONSTER_MODEL_PATH=
RVC_STORYBOOK_MODEL_PATH=
RVC_TIMEOUT_SECONDS=1800

# Video generation B-Roll: choose `sora` or `runway`. Generated clips are downloaded back into MinIO,
# so provider result URLs are never returned to the browser. Runway Gen-3 is legacy; configure a current Runway model.
VIDEO_GENERATION_PROVIDER=sora
VIDEO_GENERATION_TIMEOUT_SECONDS=1800
SORA_VIDEO_MODEL=sora-2
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_API_VERSION=2024-11-06
# Generate B-Roll automatically only if the subtitle window is information-dense and this visual-motion score is lower.
BROLL_MAX_VISUAL_MOTION=0.055

# Travel route map generation. This server-only Mapbox token must never use a
# NEXT_PUBLIC_ prefix. Set PERMANENT=true only with Mapbox storage permission.
MAPBOX_ACCESS_TOKEN=
MAPBOX_GEOCODING_PERMANENT=false
TRAVEL_MAP_GEOCODING_TIMEOUT_SECONDS=20
TRAVEL_MAP_RENDER_TIMEOUT_SECONDS=300

# Server-side Meme/GIF search. Keep the vendor keys on workers only; every
# downloaded GIF retains source attribution for creator review before render.
MEME_GIF_PROVIDER=tenor
TENOR_API_KEY=
TENOR_CLIENT_KEY=ai-video-editor
GIPHY_API_KEY=
MEME_GIF_MAX_EVENTS=5
MEME_GIF_DOWNLOAD_MAX_BYTES=26214400
MEME_GIF_TIMEOUT_SECONDS=30

# GPU video outpainting. The command must run a temporal diffusion/outpainting pipeline and contain all placeholders.
# Example contract: python /opt/outpaint.py --input {input} --output {output} --width {width} --height {height} --edge-manifest {edge_manifest}
VIDEO_OUTPAINT_PROVIDER=svd_cli
SVD_OUTPAINT_COMMAND=

# GPU-only spatial reconstruction. COLMAP extracts sequential video poses and a dense fused point cloud.
# Mount a pinned 3DGS implementation into the worker and configure the command contracts below.
COLMAP_COMMAND=colmap
# Example: python /opt/gaussian-splatting/train.py -s {input} -m {output} --iterations {iterations} --disable_viewer
THREE_DGS_TRAIN_COMMAND=
# Example: python /opt/3dgs-render/render_virtual_path.py --scene {scene} --camera-path {camera_path} --output {output} --fps {fps} --width {width} --height {height}
THREE_DGS_RENDER_COMMAND=
SPATIAL_TRAINING_TIMEOUT_SECONDS=28800
SPATIAL_RENDER_TIMEOUT_SECONDS=7200

# Live Director: OBS publishes to rtmp://localhost:1935/live/<session_id>/<camera_id>.
# MediaMTX terminates RTMP/WebRTC, while FastAPI/aiortc switches and publishes the program feed.
LIVE_MEDIAMTX_INTERNAL_RTSP_BASE_URL=rtsp://mediamtx:8554
LIVE_MEDIAMTX_PUBLIC_RTMP_BASE_URL=rtmp://localhost:1935
LIVE_RTMP_PORT=1935
LIVE_RTSP_PORT=8554
LIVE_WEBRTC_PORT=8889
LIVE_WEBRTC_UDP_PORT=8189
LIVE_VAD_THRESHOLD=0.62
LIVE_MIN_SWITCH_SECONDS=0.8
LIVE_VIDEO_CODEC=libx264
LIVE_CAPTIONS_ENABLED=true
LIVE_CAPTION_WINDOW_SECONDS=2.0
LIVE_CAPTION_TTL_SECONDS=2.8
# Optional pinned Silero VAD TorchScript model mounted into the backend container.
SILERO_VAD_TORCHSCRIPT_PATH=

# Forensic delivery is deliberately fail-closed when enabled: generate and store
# WATERMARK_ENCRYPTION_KEY in a secret manager, never in source control.
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FORENSIC_WATERMARK_ENABLED=false
WATERMARK_ENCRYPTION_KEY=
WATERMARK_FRAME_STRIDE=15
WATERMARK_DCT_STRENGTH=18
WATERMARK_MIN_COPIES=3
WATERMARK_MAX_COPIES=7

# c2patool is a separately pinned render-node binary. The signer command must
# use a KMS/HSM or remote signer; do not pass a private-key path through env.
C2PA_ENABLED=false
C2PATOOL_COMMAND=c2patool
C2PA_SIGNER_PATH=
C2PA_CLAIM_GENERATOR=AI Video Editor/1.0
C2PA_TIMEOUT_SECONDS=300

# Headless Platform API. Generate PLATFORM_API_KEY_PEPPER as a random 32+ byte
# secret and PLATFORM_WEBHOOK_ENCRYPTION_KEY with Fernet.generate_key().
PLATFORM_API_KEY_PEPPER=
PLATFORM_WEBHOOK_ENCRYPTION_KEY=
PLATFORM_REDIS_KEY_PREFIX=platform:rate
PLATFORM_MAX_SOURCE_BYTES=5368709120
PLATFORM_ALLOW_PRIVATE_SOURCE_URLS=false
PLATFORM_WEBHOOK_TIMEOUT_SECONDS=15
# Temporary management gate until the application-wide user/JWT dependency is wired in.
PLATFORM_MANAGEMENT_TOKEN=

# Camera-to-Cloud ingest. Mount the Fernet key through a secret manager and
# expose the device gateway only behind TLS (or mTLS) capable Nginx/ALB.
INGEST_DEVICE_ENCRYPTION_KEY=
INGEST_MANAGEMENT_TOKEN=
INGEST_REQUIRE_TLS=true
INGEST_MAX_CHUNK_BYTES=2147483648
INGEST_SIGNATURE_MAX_AGE_SECONDS=300
INGEST_REPLAY_TTL_SECONDS=900

# Optional calibrated PyTorch Transformer checkpoint. Without it the product uses
# a clearly-labelled heuristic baseline and must not present it as observed analytics.
RETENTION_MODEL_PATH=
RETENTION_WINDOW_SECONDS=1.0

# Spatial Video: supply an FFmpeg build with `hevc_nvenc` Multiview Main support.
# The writer/verifier run on a macOS worker built with Apple's spatial metadata APIs.
SPATIAL_FFMPEG_PATH=/opt/spatial-ffmpeg/bin/ffmpeg
SPATIAL_FFPROBE_PATH=/opt/spatial-ffmpeg/bin/ffprobe
SPATIAL_METADATA_WRITER_COMMAND=
SPATIAL_METADATA_VERIFIER_COMMAND=
SPATIAL_MVHEVC_TIMEOUT_SECONDS=14400
