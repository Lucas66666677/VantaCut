# Use managed PostgreSQL, Redis, and S3-compatible object storage in production.
ENVIRONMENT=production
MOCK_AI=false
CORS_ALLOWED_ORIGINS=https://app.example.com

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@managed-postgres.example.com:5432/video_editor
REDIS_URL=rediss://:PASSWORD@managed-redis.example.com:6380/0
CELERY_BROKER_URL=rediss://:PASSWORD@managed-redis.example.com:6380/0
CELERY_RESULT_BACKEND=rediss://:PASSWORD@managed-redis.example.com:6380/1

S3_ENDPOINT_URL=https://s3.example.com
S3_PUBLIC_ENDPOINT_URL=https://media.example.com
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=video-editor-production

GEMINI_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
AI_VISION_PROVIDER=gemini
AI_ASR_PROVIDER=openai_whisper
AI_TEXT_PROVIDER=gemini
AI_DIRECTOR_PROVIDER=openai
OPENAI_DIRECTOR_MODEL=gpt-4o
AI_EMBEDDING_PROVIDER=open_clip
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
# Must include {text_file}, {output}, and {language}; write a WAV file at {output}.
TTS_COMMAND=
KINETIC_SUBTITLE_WEBM=false

# Mount a vetted, licensed ONNX gaze-redirection model read-only into the worker and set its container path.
GAZE_REDIRECTION_ONNX_PATH=

# GPU inpainting worker. Provision ProPainter weights and expose its inference command explicitly.
VIDEO_INPAINTING_PROVIDER=propainter
PROPAINTER_COMMAND=
CELERY_INPAINTING_QUEUE=gpu

# Install backend/requirements.sam2.txt in the GPU image and mount the licensed/approved checkpoint read-only.
SAM2_CHECKPOINT_PATH=
SAM2_CONFIG_PATH=configs/sam2.1/sam2.1_hiera_l.yaml
MATTING_FRAME_STRIDE=1

# Provision and operate these licensed/model-specific wrappers in the appropriate GPU/post facility.
AUDIO_GENERATION_COMMAND=
DOLBY_ATMOS_ENCODER_COMMAND=

# Must be baked into the Next.js browser bundle at image build time.
NEXT_PUBLIC_API_URL=https://example.com
REGISTRY=registry.example.com/team
IMAGE_TAG=2026.07.15
TLS_CERTS_PATH=/opt/ai-video-editor/certs
