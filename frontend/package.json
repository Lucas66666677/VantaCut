{
  "name": "ai-video-editor-frontend",
  "private": true,
  "scripts": {
    "prepare:ort": "node scripts/copy-ort-assets.mjs",
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-assets.mjs",
    "prepare:assets": "npm run prepare:ort && npm run prepare:ffmpeg",
    "dev": "npm run prepare:assets && next dev",
