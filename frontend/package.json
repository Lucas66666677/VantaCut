    "framer-motion": "^12.42.2",
    "next": "15.1.3",
    "onnxruntime-web": "^1.27.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.185.1",
    "yjs": "^13.6.27",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
